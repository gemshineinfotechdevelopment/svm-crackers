# Backend API base URL for Frontend build (Vite environment variable)
# When deploying on VPS with Nginx reverse proxy (Subdomain: apsara-crackers.gemshine.tech):
# Use relative '/api' so Nginx routes /api/ requests to localhost:5015
VITE_API_URL=/api

# Local Development:
# VITE_API_URL=http://localhost:5015/api

